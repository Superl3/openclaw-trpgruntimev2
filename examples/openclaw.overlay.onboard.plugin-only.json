{
  "plugins": {
    "load": {
      "paths": ["~/.openclaw/extensions/trpg-runtime-v2"],
      "allow": ["trpg-runtime-v2"]
    },
    "entries": {
      "trpg-runtime-v2": {
        "enabled": true,
        "config": {
          "allowPatchApply": false,
          "allowedAgentIds": []
        }
      }
    }
  }
}
