{
  "name": "trpg-runtime-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Local OpenClaw plugin providing structured TRPG runtime tools",
  "type": "module",
  "scripts": {
    "build": "node -e \"console.log('trpg-runtime-v2: no build step required (TS loaded via jiti).')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:manifest": "node -e \"const fs=require('fs');const path=require('path');const root=process.env.INIT_CWD||process.cwd();const manifestPath=path.resolve(root,'openclaw.plugin.json');const m=JSON.parse(fs.readFileSync(manifestPath,'utf8'));if(!m.id||!m.configSchema){throw new Error('manifest invalid')}console.log('manifest ok:',m.id)\"",
    "smoke:gamer-live": "node ./scripts/run-gamer-smoke-live.mjs",
    "smoke:session-validate": "node ./scripts/validate-smoke-session.mjs",
    "smoke:drifter-audit": "node ./scripts/analyze-drifter-feedback.mjs",
    "smoke:drifter-divergence": "node ./scripts/run-drifter-divergence.mjs",
    "drifter:snapshot": "node ./scripts/drifter-snapshot.mjs",
    "test:smoke-session-validity": "node --test tests/runtime-gamer-agent/smoke-session-validity.test.mjs",
    "scaffold:gamer-profile": "node ./scripts/scaffold-gamer-agent-profile.mjs",
    "seed:validate": "node ./scripts/validate-world-seed.mjs",
    "factions:validate": "node ./scripts/validate-factions-canon.mjs",
    "factions:drift-vs-seed": "node ./scripts/diff-factions-vs-seed.mjs",
    "factions:scaffold-from-seed": "node ./scripts/scaffold-factions-from-seed.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}
